node_modules/

# secrets / local env — this project's tools read live JWT/API keys
# (NC_MAINNET_SEASONPASS_JWT_KEY, X-API-Key) that get supplied via env vars
.env
.env.*
!.env.example

# tool-generated local artifacts — arena-reward-table --png, arena-settlement-check
# --log-file, and *-csv inputs/outputs are always explicit CLI paths, never written
# here by default, but keep the repo root safe if someone points one in-tree
*.png
*.jsonl
*.log
*.csv

# bun test coverage
coverage/

# 구글 서비스 계정 키(spec-to-datasheet-apply --apply). GOOGLE_SHEETS_SA_KEY_PATH로 실행 시점에
# 주입하는 것이 원칙이라 여기 있으면 안 되지만, 실수로 레포 안에 두는 경우를 막는 안전망이다.
*service-account*.json
*sa-key*.json

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
